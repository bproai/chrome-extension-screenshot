{
  "name": "chrome-extension-screenshot-server",
  "version": "1.0.0",
  "description": "Server for handling MongoDB operations for the screenshot extension",
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:webpack": "webpack --mode development",
    "build": "npm run build:css && npm run build:webpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.504.0",
    "@aws-sdk/s3-request-presigner": "^3.504.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "markdown-it": "^14.1.0",
    "markdown-it-multimd-table": "^4.2.3",
    "mongodb": "^6.3.0",
    "openai": "^4.24.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^3.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@tailwindcss/typography": "^0.5.10",
    "babel-loader": "^9.1.3",
    "html-webpack-plugin": "^5.6.3",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
